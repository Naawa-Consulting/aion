# Backend settings

# Postgres connection string (Supabase Postgres in production). Falls back to a local
# SQLite file if unset — only useful for quick local experiments.
# AION_DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Supabase project settings (dashboard: Project Settings > API)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# Supabase Storage bucket used for dataset Parquet files
# AION_STORAGE_BUCKET=aion-datasets

# Comma-separated emails allowed to create new companies via /admin (platform admins)
# AION_PLATFORM_ADMIN_EMAILS=sebastian@naawaconsulting.com

# Comma-separated list of allowed CORS origins (the frontend's URL(s))
# AION_ALLOWED_ORIGINS=http://localhost:3000
